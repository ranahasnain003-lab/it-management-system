# Deploy-time settings for the AI Assistant backend.
#
# Copy to functions/.env before `firebase deploy --only functions` if you need
# to change a default. This file holds no secrets: the OpenAI key lives only in
# Google Secret Manager (firebase functions:secrets:set OPENAI_API_KEY).

# Whether askInventoryAssistant requires a verified Firebase App Check token.
#
# Leave unset (or set to true) for normal operation.
#
# Set to false ONLY while the Android build is side-loaded as an APK rather
# than installed from Google Play: the Play Integrity provider issues tokens
# only for Play-distributed builds, so enforcement would reject every call.
# With it false, the function still requires a signed-in, email-verified
# account and still applies the per-account daily cap.
#AI_REQUIRE_APP_CHECK=true
