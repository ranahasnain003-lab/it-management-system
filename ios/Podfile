# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# Per-file compiler flags that must be removed from BoringSSL-GRPC. Listed by
# exact spelling, never by prefix: the pod's other flags (-DOPENSSL_NO_ASM, -w
# and -DBORINGSSL_PREFIX=GRPC) are all required and must survive.
BORINGSSL_INVALID_FLAGS = ['-GCC_WARN_INHIBIT_ALL_WARNINGS'].freeze

# Source patches applied to installed pods after CocoaPods has fetched them.
#
# gRPC-Core 1.62.x, which Firebase/Firestore 10.25.0 pins, contains:
#
#   Traits::template CallSeqFactory(f_, *cur_, std::move(arg))
#
# The "template" keyword may only precede a name that carries a template
# argument list. It does not here, so the code has always been ill-formed;
# older toolchains accepted it, and clang in current Xcode refuses with
#
#   A template argument list is expected after a name prefixed by the
#   template keyword
#
# Upstream gRPC dropped the keyword in a later release. Until the Firebase
# SDK pin moves to a gRPC that contains that fix, the installed copy is
# corrected here. The same file also uses the keyword correctly on the line
# above, as "Traits::template CheckResultAndRunNext<Wrapped>(...)", which is
# left alone: only the form with no argument list is replaced.
# gRPC-Core and gRPC-C++ each vendor their own copy of the same upstream
# source tree, so this identical file is installed twice, once under each pod.
# Both copies are compiled, so both have to be corrected - fixing only
# gRPC-Core leaves the gRPC-C++ copy to fail the build at the same line.
POD_SOURCE_PATCHES = [
  {
    'name' => 'gRPC template keyword',
    'pods' => ['gRPC-Core', 'gRPC-C++'],
    'file' => 'src/core/lib/promise/detail/basic_seq.h',
    'broken' => 'Traits::template CallSeqFactory(',
    'fixed' => 'Traits::CallSeqFactory(',
  },
].freeze

# Corrects one installed file. Returns true only if it was actually rewritten.
#
# Deliberately an exact string replacement rather than a regular expression,
# so it cannot touch anything it was not aimed at: "::template" is never
# removed in general, only the single spelling that carries no argument list.
# Safe to run twice, and it never fails the build - if the broken text is
# absent, the copy has either already been corrected or has been fixed
# upstream, and both of those are fine.
def patch_pod_file(file, label, patch)
  unless File.exist?(file)
    Pod::UI.puts "[patch] #{label}: not installed, nothing to do"
    return false
  end

  contents = File.read(file)

  unless contents.include?(patch['broken'])
    state = contents.include?(patch['fixed']) ? 'already correct' : 'pattern not present, assuming fixed upstream'
    Pod::UI.puts "[patch] #{label}: #{state}"
    return false
  end

  occurrences = contents.scan(patch['broken']).length
  File.write(file, contents.gsub(patch['broken'], patch['fixed']))
  Pod::UI.puts "[patch] #{label}: corrected #{occurrences} template-keyword use(s) in #{File.basename(file)}"
  true
end

# Applies every patch above to each pod that is expected to carry it, then
# sweeps the rest of the sandbox for the same relative file.
#
# That sweep is why this is written as a search rather than a fixed list of
# paths: gRPC-C++ turned out to ship the same file as gRPC-Core and failed the
# build only after gRPC-Core was fixed. A further pod vendoring the same
# source is now corrected and named in the build log instead of surfacing as
# another compiler error.
def apply_pod_source_patches(installer)
  pods_root = installer.sandbox.root

  POD_SOURCE_PATCHES.each do |patch|
    patch['pods'].each do |pod|
      patch_pod_file(File.join(pods_root.to_s, pod, patch['file']), "#{patch['name']} / #{pod}", patch)
    end

    Dir.glob(File.join(pods_root.to_s, '*', patch['file'])).each do |file|
      pod = Pathname.new(file).relative_path_from(pods_root).each_filename.first
      next if patch['pods'].include?(pod)

      Pod::UI.puts "[patch] #{patch['name']}: the same file is also present in unlisted pod #{pod}"
      patch_pod_file(file, "#{patch['name']} / #{pod}", patch)
    end
  end
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Workaround for BoringSSL-GRPC, which Firebase/Firestore pulls in through
    # gRPC. Its podspec attaches these per-file compiler flags:
    #
    #   -DOPENSSL_NO_ASM  -GCC_WARN_INHIBIT_ALL_WARNINGS  -w  -DBORINGSSL_PREFIX=GRPC
    #
    # Only the second one is invalid. It was meant to be an Xcode build
    # setting, not a clang flag; older toolchains ignored it, and clang in
    # current Xcode reads it as the option "-G" and stops with
    #
    #   unsupported option '-G' for target 'arm64-apple-ios...'
    #
    # All it ever did was silence warnings, so removing it costs nothing. It
    # is matched by exact spelling rather than by a "-G" prefix so that
    # -DBORINGSSL_PREFIX=GRPC and -DOPENSSL_NO_ASM, which the pod genuinely
    # needs and whose removal would break the build, can never be caught by
    # accident. Every other pod, and every Flutter build setting applied
    # above, is left untouched.
    next unless target.name == 'BoringSSL-GRPC'

    removed = 0

    target.source_build_phase.files.each do |file|
      next if file.settings.nil?
      flags = file.settings['COMPILER_FLAGS']
      next if flags.nil?

      present = flags.split
      kept = present.reject { |flag| BORINGSSL_INVALID_FLAGS.include?(flag) }
      next if kept.length == present.length

      file.settings['COMPILER_FLAGS'] = kept.join(' ')
      removed += present.length - kept.length
    end

    Pod::UI.puts(removed.zero? ?
      '[patch] BoringSSL-GRPC: no invalid compiler flags found, nothing to remove' :
      "[patch] BoringSSL-GRPC: removed #{removed} invalid compiler flag(s)")
  end

  apply_pod_source_patches(installer)
end
