# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

# Source patches applied to installed pods after CocoaPods has fetched them.
#
# gRPC-Core 1.62.x, which Firebase/Firestore 10.25.0 pins, contains:
#
#   Traits::template CallSeqFactory(f_, *cur_, std::move(arg))
#
# The "template" keyword may only precede a name that carries a template
# argument list. It does not here, so the code has always been ill-formed;
# older toolchains accepted it, and clang in current Xcode refuses with
#
#   A template argument list is expected after a name prefixed by the
#   template keyword
#
# Upstream gRPC dropped the keyword in a later release. Until the Firebase
# SDK pin moves to a gRPC that contains that fix, the installed copy is
# corrected here. The same file also uses the keyword correctly on the line
# above, as "Traits::template CheckResultAndRunNext<Wrapped>(...)", which is
# left alone: only the form with no argument list is replaced.
POD_SOURCE_PATCHES = [
  {
    'pod' => 'gRPC-Core',
    'path' => 'gRPC-Core/src/core/lib/promise/detail/basic_seq.h',
    'broken' => 'Traits::template CallSeqFactory(',
    'fixed' => 'Traits::CallSeqFactory(',
  },
].freeze

# Rewrites the files listed above inside the Pods sandbox.
#
# Deliberately an exact string replacement rather than a regular expression,
# so it cannot touch anything it was not aimed at. It is safe to run twice,
# and it never fails the build: if the broken text is absent the pod has
# either already been patched or has been fixed upstream, and both are fine.
def apply_pod_source_patches(installer)
  pods_root = installer.sandbox.root.to_s

  POD_SOURCE_PATCHES.each do |patch|
    file = File.join(pods_root, patch['path'])

    unless File.exist?(file)
      Pod::UI.puts "[patch] #{patch['pod']}: #{patch['path']} is not installed, nothing to do"
      next
    end

    contents = File.read(file)

    unless contents.include?(patch['broken'])
      state = contents.include?(patch['fixed']) ? 'already patched' : 'pattern not present, assuming fixed upstream'
      Pod::UI.puts "[patch] #{patch['pod']}: #{state}"
      next
    end

    occurrences = contents.scan(patch['broken']).length
    File.write(file, contents.gsub(patch['broken'], patch['fixed']))
    Pod::UI.puts "[patch] #{patch['pod']}: corrected #{occurrences} template-keyword use(s) in #{File.basename(file)}"
  end
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Workaround for BoringSSL-GRPC, which Firebase/Firestore pulls in through
    # gRPC. Its podspec attaches "-GCC_WARN_INHIBIT_ALL_WARNINGS" to every
    # source file as a per-file compiler flag. Older toolchains ignored it;
    # clang in current Xcode reads it as the option "-G" and stops with
    #
    #   unsupported option '-G' for target 'arm64-apple-ios...'
    #
    # Nothing in this project sets that flag, and all it ever did was silence
    # warnings, so it is removed from that one pod's files. Every other pod,
    # and every Flutter build setting applied above, is left untouched.
    next unless target.name == 'BoringSSL-GRPC'

    target.source_build_phase.files.each do |file|
      next if file.settings.nil?
      flags = file.settings['COMPILER_FLAGS']
      next if flags.nil?

      kept = flags.split.reject { |flag| flag.start_with?('-G') }
      file.settings['COMPILER_FLAGS'] = kept.join(' ')
    end
  end

  apply_pod_source_patches(installer)
end
