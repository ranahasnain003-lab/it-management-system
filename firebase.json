{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(js|wasm|mjs)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "it-inventory-8e690",
          "appId": "1:315288299970:android:f61bff62f4f7418711ce5b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "it-inventory-8e690",
          "configurations": {
            "android": "1:315288299970:android:f61bff62f4f7418711ce5b",
            "ios": "1:315288299970:ios:6e2f76846735cc4d11ce5b",
            "macos": "1:315288299970:ios:6e2f76846735cc4d11ce5b",
            "web": "1:315288299970:web:6aa5720e86d0fb1511ce5b",
            "windows": "1:315288299970:web:479bfd19acc050e811ce5b"
          }
        }
      }
    }
  }
}