rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // BASIC HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/requests/$(requestId);
    }

    function assetPath(assetId) {
      return /databases/$(database)/documents/assets/$(assetId);
    }

    function currentUserExists() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    // Only these statuses may use the system. 'blocked', 'disabled',
    // 'inactive', 'pending' and 'deleted' are all denied. Read in any letter
    // case and with surrounding spaces trimmed, as the app reads it: a profile
    // edited by hand in the Firebase console as 'ACTIVE' or ' active ' must
    // not be let in by the app and refused here.
    function isActiveStatus(data) {
      return data.get('status', '').trim().lower() in ['active', 'approved'];
    }

    // The role STORED on an existing profile, trimmed and in lower case. The
    // app reads roles case-insensitively, so a profile saved by hand in the
    // Firebase console as 'Admin' (or ' admin ') was shown as an Administrator
    // while every rule comparing against 'admin' refused it - the whole
    // inventory query failed with permission-denied. Only stored values are
    // read this way: every rule that WRITES a role still requires the exact
    // lower-case value, and no account may change its own role.
    function roleOf(data) {
      return data.get('role', '').trim().lower();
    }

    // Only these three roles exist. Anything else stored in `role` - a typo, a
    // value from an older version, a missing field - grants nothing.
    // PermissionService decides the same way (an unknown role resolves to no
    // permissions at all), and the rules must never be more permissive than
    // the screens: an account the app shows as powerless would otherwise still
    // be able to read the whole inventory through a direct API call.
    function isKnownRole(data) {
      return roleOf(data) in ['super_admin', 'admin', 'user'];
    }

    // Login refuses unverified email addresses; enforced here too so a
    // restored session or a direct API call cannot skip that check. The role
    // is checked here rather than at every call site, so a rule added later
    // cannot forget it.
    function isActiveUser() {
      return currentUserExists()
        && request.auth.token.email_verified == true
        && isActiveStatus(currentUser())
        && isKnownRole(currentUser());
    }

    function currentRole() {
      return roleOf(currentUser());
    }

    function isSuperAdmin() {
      return isActiveUser() && currentRole() == 'super_admin';
    }

    function isAdmin() {
      return isActiveUser() && currentRole() == 'admin';
    }

    function isUser() {
      return isActiveUser() && currentRole() == 'user';
    }

    function isManager() {
      return isSuperAdmin() || isAdmin();
    }

    // ============================================================
    // USER -> ADMIN RELATIONSHIP
    // ============================================================
    //
    // users/{userId}.createdBy == UID of the Admin (or Super Admin) who
    // created the account. It no longer decides what a User may READ -
    // inventory and movement history are organisation-wide - but it still
    // decides who OWNS an asset a User adds, and who a User's request is
    // routed to.
    // ============================================================

    function currentUserAdminUid() {
      return currentUser().get('createdBy', '');
    }

    function isActiveAdminUid(uid) {
      return uid is string
        && uid != ''
        && exists(userPath(uid))
        && roleOf(get(userPath(uid)).data) == 'admin'
        && isActiveStatus(get(userPath(uid)).data);
    }

    // `roles` (when present) must mirror the single primary `role`.
    // Prevents injecting e.g. roles: ['super_admin'] next to role: 'user'.
    function validRoles(data) {
      return !data.keys().hasAny(['roles'])
        || data.roles.hasOnly([data.role]);
    }

    // ============================================================
    // ASSET HELPERS
    // ============================================================

    // A request may only name inventory that really exists. A User may read
    // the whole inventory (see /assets below), so a User may also ASK about
    // any of it - which is all a request is. The asset itself stays
    // unwritable for a User: only a manager's approval changes it.
    function assetExists(assetId) {
      return assetId is string
        && assetId != ''
        && exists(assetPath(assetId));
    }

    // Owner UID of an asset or movement record; missing or null -> ''.
    function ownerOf(data) {
      return data.get('adminId', null) == null ? '' : data.adminId;
    }

    function hasStockFields(data) {
      return data.keys().hasAll([
        'quantity',
        'headOfficeQuantity',
        'assignedQuantity',
        'deployedQuantity'
      ]);
    }

    // INVENTORY INVARIANT:
    // quantity = headOfficeQuantity + assignedQuantity + deployedQuantity
    function stockConsistent(data) {
      return hasStockFields(data)
        && data.quantity is int
        && data.headOfficeQuantity is int
        && data.assignedQuantity is int
        && data.deployedQuantity is int
        && data.quantity >= 0
        && data.headOfficeQuantity >= 0
        && data.assignedQuantity >= 0
        && data.deployedQuantity >= 0
        && data.headOfficeQuantity
          + data.assignedQuantity
          + data.deployedQuantity == data.quantity;
    }

    // Legacy assets without an owner may be claimed by the Admin
    // editing/moving them. Existing ownership can never change.
    function adminOwnershipPreserved() {
      return request.resource.data.get('adminId', null) == resource.data.get('adminId', null)
        || (
          resource.data.get('adminId', null) in [null, '']
          && request.resource.data.get('adminId', null) == request.auth.uid
        );
    }

    // ============================================================
    // SUPER ADMIN HANDOVER
    // ============================================================

    function handoverKeys() {
      return [
        'role', 'roles', 'designation',
        'superAdminTransferredAt', 'superAdminTransferredTo',
        'superAdminTransferredFrom'
      ];
    }

    function validSuperAdminHandoverTarget(targetUid) {
      return isSuperAdmin()
        && targetUid != request.auth.uid
        && isActiveAdminUid(targetUid)
        && getAfter(userPath(request.auth.uid)).data.role == 'admin'
        && getAfter(userPath(targetUid)).data.role == 'super_admin';
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Every signed-in account can read its OWN profile regardless
      // of status, so a blocked/disabled account is shown the real
      // reason instead of a permission error.
      //
      // Super Admin / Admin: all users.
      // ----------------------------------------------------------

      allow read: if isSignedIn() && userId == request.auth.uid;

      allow read: if isManager();

      // ----------------------------------------------------------
      // PUBLIC SIGNUP
      // ----------------------------------------------------------
      //
      // A newly authenticated account may create ONLY its own
      // profile as a PENDING, unassigned User. 'pending' is not an
      // active status, so a self-registered account can do nothing
      // until a Super Admin (or the Admin who manages it) activates
      // it. Accounts created by a Super Admin/Admin below are active
      // straight away.
      // ----------------------------------------------------------

      allow create: if isSignedIn()
        && userId == request.auth.uid
        && !currentUserExists()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user'
        && validRoles(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == ''
        && request.resource.data.get('createdByEmail', '') == ''
        && request.resource.data.get('adminId', '') == ''
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'roles',
          'status',
          'employeeId',
          'department',
          'designation',
          'phone',
          'phoneNumber',
          'createdBy',
          'createdByEmail',
          'organizationId',
          'createdAt'
        ]);

      // ----------------------------------------------------------
      // SUPER ADMIN CREATE
      // ----------------------------------------------------------
      //
      // Admin: createdBy = Super Admin.
      // User:  createdBy = Super Admin, or an existing active Admin
      //        the User is assigned to.
      //
      // A Super Admin can never be created directly.
      // ----------------------------------------------------------

      allow create: if isSuperAdmin()
        && userId != request.auth.uid
        && request.resource.data.uid == userId
        && validRoles(request.resource.data)
        && (
          (
            request.resource.data.role == 'admin'
            && request.resource.data.createdBy == request.auth.uid
          )
          ||
          (
            request.resource.data.role == 'user'
            && (
              request.resource.data.createdBy == request.auth.uid
              || isActiveAdminUid(request.resource.data.createdBy)
            )
          )
        );

      // ----------------------------------------------------------
      // ADMIN CREATE
      // ----------------------------------------------------------

      allow create: if isAdmin()
        && userId != request.auth.uid
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && validRoles(request.resource.data)
        && isActiveStatus(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      // ----------------------------------------------------------
      // SUPER ADMIN UPDATE
      // ----------------------------------------------------------
      //
      // Any other non-Super-Admin account. Cannot promote anyone to
      // Super Admin (handover has its own rule below).
      // ----------------------------------------------------------

      allow update: if isSuperAdmin()
        && userId != request.auth.uid
        && roleOf(resource.data) != 'super_admin'
        && request.resource.data.role in ['admin', 'user']
        && validRoles(request.resource.data)
        // The profile always stays bound to its Firebase Auth account.
        && request.resource.data.uid == userId
        && request.resource.data.email == resource.data.email;

      // ----------------------------------------------------------
      // ADMIN UPDATE
      // ----------------------------------------------------------
      //
      // Only Users managed by this Admin; role and ownership are
      // immutable for an Admin.
      // ----------------------------------------------------------

      // Descriptive details, plus the soft delete (status -> 'deleted') and
      // activating a self-registered account ('pending' -> 'active') so an
      // Admin can admit the Users it manages without the Super Admin. Any
      // other status change (e.g. 'blocked') stays reserved for the Super
      // Admin.
      allow update: if isAdmin()
        && userId != request.auth.uid
        && roleOf(resource.data) == 'user'
        && resource.data.get('createdBy', '') in [request.auth.uid, '']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'employeeId',
          'department',
          'designation',
          'phone',
          'phoneNumber',
          'updatedAt',
          'lastUpdated',
          'status',
          'deletedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status == 'deleted'
          || (
            resource.data.get('status', '').trim().lower() == 'pending'
            && request.resource.data.status == 'active'
          )
        );

      // ----------------------------------------------------------
      // SELF PROFILE UPDATE
      // ----------------------------------------------------------
      //
      // An active account may edit its own descriptive fields only.
      // Role, roles, status, ownership and email are NOT editable.
      // ----------------------------------------------------------

      allow update: if isActiveUser()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'department',
          'designation',
          'phone',
          'phoneNumber',
          'updatedAt',
          'lastUpdated'
        ]);

      // ----------------------------------------------------------
      // SUPER ADMIN HANDOVER: current Super Admin -> Admin
      // ----------------------------------------------------------

      allow update: if userId == request.auth.uid
        && request.resource.data.keys().hasAny(['superAdminTransferredTo'])
        && validSuperAdminHandoverTarget(
          request.resource.data.superAdminTransferredTo
        )
        && request.resource.data.role == 'admin'
        && validRoles(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(handoverKeys());

      // ----------------------------------------------------------
      // SUPER ADMIN HANDOVER: target Admin -> Super Admin
      // ----------------------------------------------------------

      allow update: if userId != request.auth.uid
        && request.resource.data.role == 'super_admin'
        && validRoles(request.resource.data)
        && validSuperAdminHandoverTarget(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(handoverKeys());

      // ----------------------------------------------------------
      // APPOINT ADDITIONAL SUPER ADMIN (active Admin -> Super Admin)
      // ----------------------------------------------------------
      //
      // Several Super Admins may exist, so the system never depends on
      // a single person's account. No account is hard-coded.
      // ----------------------------------------------------------

      allow update: if isSuperAdmin()
        && userId != request.auth.uid
        && roleOf(resource.data) == 'admin'
        && isActiveStatus(resource.data)
        && request.resource.data.role == 'super_admin'
        && validRoles(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'roles', 'designation',
          'promotedToSuperAdminBy', 'promotedToSuperAdminAt'
        ]);

      // ----------------------------------------------------------
      // REMOVE ANOTHER SUPER ADMIN (Super Admin -> Admin)
      // ----------------------------------------------------------
      //
      // Never one's own account: the acting Super Admin remains, so at
      // least one Super Admin always exists. Stepping down is only
      // possible through the handover above.
      // ----------------------------------------------------------

      allow update: if isSuperAdmin()
        && userId != request.auth.uid
        && roleOf(resource.data) == 'super_admin'
        && request.resource.data.role == 'admin'
        && validRoles(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'roles', 'designation',
          'demotedFromSuperAdminBy', 'demotedFromSuperAdminAt'
        ]);

      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      // Profiles are never hard-deleted: the Firebase Auth account survives a
      // document delete and could then re-create itself as a new active
      // account through the public signup rule above. UserService.deleteUser
      // soft-deletes instead (status 'deleted' + deletedAt).
      allow delete: if false;
    }

    // ============================================================
    // REQUESTS
    // ============================================================

    match /requests/{requestId} {

      // An Admin may already change any inventory directly, so restricting it
      // to requests about its OWN assets bought nothing: it may approve a
      // request about any inventory. The guards that matter are below - only a
      // Pending request, and never one's own.
      function canActOnRequest() {
        return isManager();
      }

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if isManager();

      allow read: if isUser()
        && (
          resource.data.requestedBy == request.auth.uid
          || resource.data.get('receiverId', '') == request.auth.uid
        );

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Every account creates only its own, Pending, unprocessed
      // request. A User may only reference inventory of their Admin.
      // ----------------------------------------------------------

      allow create: if isActiveUser()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.get('approvedBy', '') == ''
        && (
          isManager()
          ||
          (
            isUser()
            && (
              request.resource.data.get('assetId', '') == ''
              || assetExists(request.resource.data.assetId)
            )
            // A User's request is routed to the User's own Admin, or left
            // unrouted ('') for any manager to pick up - which is the only
            // possibility for a User who is not linked to an Admin.
            && request.resource.data.get('receiverId', '') in ['', currentUserAdminUid()]
          )
        );

      // ----------------------------------------------------------
      // UPDATE (approve / reject)
      // ----------------------------------------------------------
      //
      // - Only a Pending request can be processed (exactly once).
      // - Nobody can process their own request.
      // - The requester and the requested change are immutable.
      // ----------------------------------------------------------

      allow update: if canActOnRequest()
        && resource.data.status == 'Pending'
        && request.resource.data.status in ['Approved', 'Rejected']
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.get('requestType', '') == resource.data.get('requestType', '')
        && request.resource.data.get('assetId', '') == resource.data.get('assetId', '')
        && request.resource.data.get('transferQuantity', 0) == resource.data.get('transferQuantity', 0)
        && request.resource.data.get('proposedAssetData', null) == resource.data.get('proposedAssetData', null);

      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // ASSETS / INVENTORY
    // ============================================================

    match /assets/{assetId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Inventory is organisation-wide: every ACTIVE account reads all
      // of it, so a User can look anything up without being scoped to
      // one Admin. Writes below stay restricted - a User may only
      // create, never update or delete.
      // ----------------------------------------------------------

      allow read: if isActiveUser();

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      // A User may ADD inventory but never touch it afterwards, so the
      // new record must be a plain, freshly stocked asset: everything at
      // Head Office, nothing assigned or deployed. AssetService
      // ._newAssetData already forces exactly that shape, so no
      // legitimate add is refused here.
      allow create: if stockConsistent(request.resource.data)
        && (
          isSuperAdmin()
          ||
          (
            isAdmin()
            && request.resource.data.get('adminId', '') == request.auth.uid
          )
          ||
          (
            isUser()
            && request.resource.data.get('createdBy', '') == request.auth.uid
            && request.resource.data.get('adminId', '') != ''
            && request.resource.data.get('adminId', '') in [request.auth.uid, currentUserAdminUid()]
            && request.resource.data.headOfficeQuantity == request.resource.data.quantity
            && request.resource.data.assignedQuantity == 0
            && request.resource.data.deployedQuantity == 0
            && request.resource.data.get('assignedTo', null) == null
          )
        );

      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Managers only - this is what stops a User editing inventory
      // it can read. A User asks for a change through /requests.
      // A write may never turn a consistent stock record into an
      // inconsistent one.
      // ----------------------------------------------------------

      allow update: if (
          isSuperAdmin()
          || (isAdmin() && adminOwnershipPreserved())
        )
        && (
          !stockConsistent(resource.data)
          || stockConsistent(request.resource.data)
        );

      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------
      //
      // Stock that is still at a Bazaar or assigned to someone must
      // not vanish, or the movement records would point at nothing.
      // AssetService.deleteAsset refuses that case already; enforced
      // here too so a direct API call cannot skip the check.
      // ----------------------------------------------------------

      allow delete: if isManager()
        && resource.data.get('deployedQuantity', 0) == 0
        && resource.data.get('assignedQuantity', 0) == 0;
    }

    // ============================================================
    // BAZAARS (master data)
    // ============================================================

    match /bazaars/{bazaarId} {

      allow read: if isActiveUser();

      // Any active account may ADD a Bazaar: the field list is closed so a
      // create cannot smuggle in unexpected data. A User's new Bazaar is
      // always created active, because disabling one is a manager action - and
      // since the app resolves a missing isActive from `status`, both fields
      // are pinned, or leaving isActive out would be the way around it. A
      // manager may create a Bazaar already disabled: the Add dialogs show it
      // the active switch, and it could disable the Bazaar with a second write
      // anyway.
      allow create: if isActiveUser()
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && (
          isManager()
          || (
            request.resource.data.get('isActive', false) == true
            && request.resource.data.get('status', '') in ['', 'Active', 'active']
          )
        )
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'bazaarName',
          'location',
          'city',
          'contactPerson',
          'contactNumber',
          'address',
          'isActive',
          'status',
          'isMaster',
          'bazaarType',
          'type',
          'createdBy',
          'createdByName',
          'createdAt',
          'lastUpdated',
          'updatedAt'
        ])
        && request.resource.data.get('isMaster', false) == false;

      // Editing and disabling a Bazaar is a manager action. The whitelist is
      // checked with affectedKeys, not keys().hasOnly, because the oldest
      // Bazaar documents have a different shape (city/type/status and no
      // location) and must stay editable without being rewritten first.
      allow update: if isManager()
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'bazaarName',
          'location',
          'city',
          'contactPerson',
          'contactNumber',
          'address',
          'isActive',
          'status',
          'bazaarType',
          'type',
          'lastUpdated',
          'updatedAt'
        ]);

      // Bazaars are disabled, never deleted, so historical movement
      // records always keep their reference.
      allow delete: if false;
    }

    // ============================================================
    // CATEGORIES (master data)
    // ============================================================
    //
    // The document id IS the normalised name key. A create on an id that
    // already exists is evaluated as an update, so the deterministic id is
    // what stops two accounts adding the same category twice.
    // ============================================================

    match /categories/{categoryId} {

      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.nameKey == categoryId
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'nameKey',
          'createdBy',
          'createdByName',
          'createdAt'
        ]);

      // Correcting the display name is open to every active account, exactly
      // like adding a category. The ONE field that may change is `name`:
      // affectedKeys pins everything else, so no role can reach the key, the
      // author, the date, or add a field of its own through this path.
      //
      // The key never moves. It is the document id, so it cannot be changed
      // anyway, and assets record their category as text - keeping the key
      // is what lets a corrected spelling and the old one still sitting on
      // an asset collapse onto a single entry in the app's category list.
      //
      // Duplicate protection stays with the key: a rename towards a name
      // whose key another category already owns is refused by
      // CategoryService.rename inside a transaction.
      allow update: if isActiveUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.get('nameKey', '') == resource.data.get('nameKey', '');

      // Categories are never deleted, so existing assets keep their label.
      allow delete: if false;
    }

    // ============================================================
    // DEPLOYMENTS (movement history)
    // ============================================================

    match /deployments/{deploymentId} {

      // Movement history is organisation-wide, like the inventory it
      // describes: every active account may read all of it.
      allow read: if isActiveUser();

      // adminId must name the owner of the moved asset.
      allow create: if isManager()
        && request.resource.data.get('assetDocumentId', '') != ''
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && ownerOf(request.resource.data)
          == ownerOf(getAfter(assetPath(request.resource.data.assetDocumentId)).data);

      // A movement record can only give up stock, never gain it, and a
      // closed record (Transferred / Returned) can never become Active again.
      // adminId may only be filled in (legacy records) with the asset owner.
      allow update: if isManager()
        && request.resource.data.assetDocumentId == resource.data.assetDocumentId
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= resource.data.quantity
        && (
          request.resource.data.get('status', '') != 'Active'
          || resource.data.get('status', '') == 'Active'
        )
        && (
          ownerOf(request.resource.data) == ownerOf(resource.data)
          || (
            !resource.data.keys().hasAny(['adminId'])
            && ownerOf(request.resource.data)
              == ownerOf(get(assetPath(resource.data.assetDocumentId)).data)
          )
        );

      // Movement history is permanent.
      allow delete: if false;
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Request notifications are written by the requester together
      // with the request (batch), or by an Admin/Super Admin when a
      // request is processed.
      allow create: if isActiveUser()
        && request.resource.data.userId is string
        && request.resource.data.userId != ''
        && request.resource.data.isRead == false
        && request.resource.data.get('requestId', '') != ''
        && (
          isManager()
          || (
            existsAfter(requestPath(request.resource.data.requestId))
            && getAfter(requestPath(request.resource.data.requestId)).data.requestedBy == request.auth.uid
            // Only to the requester or the request's routed receiver.
            && request.resource.data.userId in [
              request.auth.uid,
              getAfter(requestPath(request.resource.data.requestId)).data.get('receiverId', '')
            ]
          )
        );

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // ACTIVITY LOGS
    // ============================================================

    match /logs/{logId} {

      allow read: if isManager();

      // Audit entries are written in the name of the signed-in account,
      // stamped with the server time, and can never be edited or deleted.
      // Any active account may write its own entry - a User adds assets and
      // Bazaars, and those actions have to be auditable too - but only a
      // manager may read the trail.
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
